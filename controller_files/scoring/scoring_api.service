[Unit]
Description=FastAPI Scoring Service
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/controller_files/scoring
ExecStart=/home/ubuntu/controller_files/scoring/venv/bin/uvicorn scoring_api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
Environment="PATH=/home/ubuntu/controller_files/scoring/venv/bin"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
